<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="h2database-jpa-pu" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:app/datasources/H2DatabaseDS</jta-data-source>

        <class>dmit2015.model.CampusEvent</class>

        <properties>
            <property name="hibernate.show_sql" value="true"/>

            <!--
                DEVELOPMENT: drop-and-create rebuilds the CAMPUS_EVENT table on every start.
                FINAL DEMO AND SUBMISSION: change this value to "none" so data persists between restarts.
                On a computer where the H2 database does not exist yet, run once with drop-and-create
                to initialize it, then change back to none.
            -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>

</persistence>
