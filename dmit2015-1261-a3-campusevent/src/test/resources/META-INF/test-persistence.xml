<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Persistence unit used only by the Arquillian integration tests.
     It points at a separate in-memory H2 data source so running `mvn verify`
     never changes the data in DMIT2015-1261-A3-JuanRodriguez-DB. -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="h2database-jpa-pu" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:app/datasources/TestH2DatabaseDS</jta-data-source>

        <class>dmit2015.model.CampusEvent</class>

        <properties>
            <property name="hibernate.show_sql" value="true"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>

</persistence>
